  "components": {
    "schemas": {
      "Catalog": {
        "properties": {
          "skills": {
            "items": {
              "$ref": "#/components/schemas/Skill"
            },
            "type": "array",
            "title": "Skills"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "skills",
          "categories"
        ],
        "title": "Catalog"
      },
      "CodexStatus": {
        "properties": {
          "installed": {
            "type": "boolean",
            "title": "Installed"
          },
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "installed",
          "authenticated",
          "message"
        ],
        "title": "CodexStatus"
      },
      "Error": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Error"
      },
      "Evidence": {
        "properties": {
          "trait": {
            "type": "string",
            "title": "Trait"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "trait",
          "excerpt"
        ],
        "title": "Evidence"
      },
      "Feedback": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "skill_id": {
            "type": "string",
            "title": "Skill Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "save",
              "pass"
            ],
            "title": "Action"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "wrong-task",
                  "wrong-style",
                  "too-much-setup"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "skill_id",
          "action",
          "id",
          "created_at"
        ],
        "title": "Feedback"
      },
      "FeedbackInput": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "skill_id": {
            "type": "string",
            "title": "Skill Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "save",
              "pass"
            ],
            "title": "Action"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "wrong-task",
                  "wrong-style",
                  "too-much-setup"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "skill_id",
          "action"
        ],
        "title": "FeedbackInput"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "catalog_count": {
            "type": "integer",
            "title": "Catalog Count"
          },
          "codex": {
            "$ref": "#/components/schemas/CodexStatus"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "catalog_count",
          "codex"
        ],
        "title": "Health"
      },
      "InstallCommands": {
        "properties": {
          "codex": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Codex"
          },
          "claude-code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claude-Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "InstallCommands"
      },
      "MatchInput": {
        "properties": {
          "task": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 3,
            "title": "Task"
          },
          "agent": {
            "type": "string",
            "enum": [
              "codex",
              "claude-code"
            ],
            "title": "Agent"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task",
          "agent"
        ],
        "title": "MatchInput"
      },
      "MatchSession": {
