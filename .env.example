# Local Docker Compose. Railway supplies its own private PostgreSQL URL.
DATABASE_URL=postgresql+psycopg://skinder:skinder@postgres:5432/skinder
APP_ORIGIN=http://127.0.0.1:8742
SKINDER_ENV=development
SKINDER_HOST=0.0.0.0
PORT=8742
SKINDER_LOG_LEVEL=INFO
SKINDER_SHUTDOWN_GRACE_SECONDS=30

# Database pools are per process.
SKINDER_DB_POOL_SIZE=5
SKINDER_DB_MAX_OVERFLOW=0
SKINDER_DB_POOL_TIMEOUT_SECONDS=10
SKINDER_DB_CONNECT_TIMEOUT_SECONDS=10

# GitHub OAuth callback: APP_ORIGIN/api/auth/callback
# Generate SESSION_SECRET with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
SKINDER_SESSION_TTL_SECONDS=2592000
SKINDER_OAUTH_HTTP_TIMEOUT_SECONDS=10

# Server-only model credentials. Never use a VITE_ prefix for secrets.
LETSUR_API_KEY=
LETSUR_BASE_URL=https://gw.letsur.ai/v1
LETSUR_MODEL=gpt-6.1-sol
SKINDER_LETSUR_TIMEOUT_SECONDS=120
SKINDER_MAX_PROMPT_BYTES=65536
SKINDER_MAX_OUTPUT_TOKENS=8192

# Quotas reset at 00:00 UTC. Cost amounts are Letsur units.
SKINDER_DAILY_BUDGET_UNITS=5
SKINDER_MATCHES_PER_USER_PER_DAY=10
SKINDER_MAX_CONCURRENT_JOBS=4
SKINDER_WORKER_POLL_SECONDS=1
SKINDER_JOB_TIMEOUT_SECONDS=180
SKINDER_QUEUE_TIMEOUT_SECONDS=600
SKINDER_JOB_LEASE_SECONDS=30
SKINDER_JOB_HEARTBEAT_SECONDS=10
SKINDER_MAX_JOB_CLAIMS=3

# Source fetching is bounded across matching jobs in each worker.
SKINDER_SOURCE_HTTP_TIMEOUT_SECONDS=10
SKINDER_SOURCE_ENRICHMENT_TIMEOUT_SECONDS=20
SKINDER_SOURCE_CONCURRENCY=4
SKINDER_SOURCE_MAX_BYTES=262144
SKINDER_SOURCE_EXCERPT_CHARS=4000
SKINDER_SOURCE_CACHE_TTL_SECONDS=604800

# The embedding model identity and its checksums are pinned in code.
SKINDER_EMBEDDING_MODEL_DIR=/opt/skinder/models/e5-small
SKINDER_EMBEDDING_THREADS=4
SKINDER_EMBEDDING_BATCH_SIZE=64
SKINDER_SYNC_KEYWORDS=["coding","testing","design","data","documentation","automation"]
SKINDER_SYNC_MAX_REQUESTS=12
SKINDER_SYNC_DAILY_REQUESTS=48
SKINDER_SYNC_HTTP_TIMEOUT_SECONDS=30
SKINDER_SYNC_MIN_INTERVAL_SECONDS=6
